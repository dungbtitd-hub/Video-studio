# Writes a C++ source with the given files as byte arrays, and a table to find them by name:
#   cmake -DOUT=<file.cpp> -DFILES="<a>;<b>" -P EmbedFiles.cmake
# Used for the bundled fonts, so every OS renders text from the same bytes with no asset plumbing.
string(REPLACE "|" ";" FILES "${FILES}")
set(body "// Generated by core/cmake/EmbedFiles.cmake. Do not edit.\n#include <cstddef>\n#include <cstdint>\n\nnamespace vstudio::embedded {\n\n")
set(table "")
set(i 0)
foreach(f IN LISTS FILES)
  get_filename_component(name "${f}" NAME)
  file(READ "${f}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  # Break the initializer into lines so compilers and editors stay happy.
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" arr "${arr}")
  string(APPEND body "static const std::uint8_t kData${i}[] = {\n${arr}\n};\n\n")
  string(APPEND table "    {\"${name}\", kData${i}, ${bytes}},\n")
  math(EXPR i "${i} + 1")
endforeach()
string(APPEND body "struct File {\n    const char* name;\n    const std::uint8_t* data;\n    std::size_t size;\n};\n\n")
string(APPEND body "extern const File kFiles[];\nextern const std::size_t kFileCount;\n\n")
string(APPEND body "const File kFiles[] = {\n${table}};\nconst std::size_t kFileCount = ${i};\n\n}  // namespace vstudio::embedded\n")
file(WRITE "${OUT}.tmp" "${body}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
